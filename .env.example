# OpenAI key used by the classifier and script writer (gpt-5.4)
OPENAI_API_KEY=
# fal.ai key used by the video module (Seedance 2.5, default provider)
FAL_KEY=
# Optional: Replicate token for the cheaper Seedance 2.0 fast fallback (MKT_VIDEO_PROVIDER=replicate)
REPLICATE_API_TOKEN=
# Optional: Apify token for the fallback TikTok scraper
APIFY_TOKEN=
# Chrome DevTools endpoint used by the browser scraper
CDP_URL=http://localhost:29229
